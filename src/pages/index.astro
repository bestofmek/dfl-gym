---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="DFL GYM | Allenati. Evolvi. Supera i tuoi limiti."
  description="DFL GYM - Allenati, evolvi e supera i tuoi limiti. Scopri la palestra e i percorsi di allenamento."
>

  <section class="hero">

    <div class="container hero-grid">

      <!-- HERO CONTENT -->

      <div class="hero-content">

        <h1>
          Allenati.<br />
          <span>Evolvi.</span><br />
          Supera i<br />
          tuoi limiti.
        </h1>


        <p class="hero-description">
          Un ambiente dedicato al tuo allenamento, ai tuoi obiettivi
          e al percorso che vuoi costruire.
        </p>


        <div class="hero-actions">

          <a
            href={`${base}contatti/`}
            class="primary-button"
          >
            Inizia il tuo percorso
          </a>


          <a
            href={`${base}palestra/`}
            class="secondary-button"
          >
            Scopri la palestra
          </a>

        </div>

      </div>


      <!-- HERO IMAGE -->

      <div
        class="hero-side"
        aria-hidden="true"
      >

        <div class="hero-frame">

          <div class="hero-frame-content">

            <img
              src={`${base}images/palestra1.jpg`}
              alt="Interno della palestra DFL GYM"
              class="hero-image"
            />

            <div class="hero-frame-overlay"></div>

            <div class="hero-frame-text">
              Il tuo allenamento
              <strong>Comincia qui.</strong>
            </div>

          </div>

        </div>

      </div>

    </div>


    <!-- =========================
         SOCIAL
    ========================== -->

    <div class="hero-bottom">

      <div class="container hero-bottom-inner">

        <a
          href="https://www.instagram.com/dfl_gym/"
          target="_blank"
          rel="noopener noreferrer"
          class="hero-social"
        >
          Instagram
        </a>


        <a
          href="https://www.facebook.com/profile.php?id=61560913769987"
          target="_blank"
          rel="noopener noreferrer"
          class="hero-social"
        >
          Facebook
        </a>


        <a
          href="https://wa.me/393808661931"
          target="_blank"
          rel="noopener noreferrer"
          class="hero-social"
        >
          WhatsApp
        </a>

      </div>

    </div>

  </section>

</BaseLayout>