---
import '../styles/global.css';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="DFL GYM - Allenati, evolvi e supera i tuoi limiti. Scopri la palestra e i percorsi di allenamento."
    />
    <title>DFL GYM | Allenati. Evolvi. Supera i tuoi limiti.</title>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">

        <a href="/" class="logo" aria-label="DFL GYM Home">
          <img
            src="/images/dfl-gym-logo.png"
            alt="DFL GYM"
            class="logo-image"
          />

          <span class="logo-text">
            <strong>DFL GYM</strong>
            <small>TIVOLI TERME</small>
          </span>
        </a>

        <nav class="main-nav" aria-label="Navigazione principale">
          <a href="#palestra">La palestra</a>
          <a href="#corsi">Corsi</a>
          <a href="#orari">Orari</a>
          <a href="#contatti">Contatti</a>
        </nav>

        <a href="#contatti" class="header-cta">
          Inizia ora
        </a>

      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-grid">

          <div class="hero-content">
            
            <h1>
              Allenati.<br />
              <span>Evolvi.</span><br />
              Supera i<br />
              tuoi limiti.
            </h1>

            <p class="hero-description">
              Un ambiente dedicato al tuo allenamento, ai tuoi obiettivi
              e al percorso che vuoi costruire.
            </p>

            <div class="hero-actions">
              <a href="#contatti" class="primary-button">
                Inizia il tuo percorso
              </a>

              <a href="#palestra" class="secondary-button">
                Scopri la palestra
              </a>
            </div>
          </div>

          <div class="hero-side" aria-hidden="true">
            <div class="hero-frame">
              <div class="hero-frame-content">
                <div class="hero-frame-text">
                  Il tuo allenamento
                  <strong>Comincia qui.</strong>
                </div>
              </div>
            </div>
          </div>

        </div>

        <div class="hero-bottom">
          <div class="container hero-bottom-inner">

            <a
              href="https://www.instagram.com/dfl_gym/"
              target="_blank"
              rel="noopener noreferrer"
              class="hero-social"
            >
              Instagram
            </a>

            <a
              href="https://www.facebook.com/profile.php?id=61560913769987"
              target="_blank"
              rel="noopener noreferrer"
              class="hero-social"
            >
              Facebook
            </a>

            <a
              href="https://wa.me/393808661931"
              target="_blank"
              rel="noopener noreferrer"
              class="hero-social"
            >
              WhatsApp
            </a>

          </div>
        </div>
      </section>
    </main>
  </body>
</html>