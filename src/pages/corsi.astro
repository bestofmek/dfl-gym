---
import '../styles/global.css';
import '../styles/corsi.css';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="Scopri i corsi e i percorsi di allenamento di DFL GYM a Tivoli Terme."
    />

    <title>Corsi | DFL GYM</title>
  </head>

  <body>

    <header class="site-header">
      <div class="container header-inner">

        <a
          href={base}
          class="logo"
          aria-label="DFL GYM Home"
        >
          <img
            src={`${base}images/dfl-gym-logo.png`}
            alt="DFL GYM"
            class="logo-image"
          />

          <span class="logo-text">
            <strong>DFL GYM</strong>
            <small>TIVOLI TERME</small>
          </span>
        </a>

        <nav
          class="main-nav"
          aria-label="Navigazione principale"
        >
          <a href={`${base}palestra/`}>
            La Palestra
          </a>

          <a href={`${base}corsi/`}>
            Corsi
          </a>

          <a href={`${base}orari/`}>
            Orari
          </a>

          <a href={`${base}contatti/`}>
            Contatti
          </a>
        </nav>

        <button
          class="mobile-menu-toggle"
          type="button"
          aria-label="Apri il menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>

        <div
          id="mobile-menu"
          class="mobile-menu-panel"
          hidden
        >
          <a href={`${base}palestra/`}>
            La Palestra
          </a>

          <a href={`${base}corsi/`}>
            Corsi
          </a>

          <a href={`${base}orari/`}>
            Orari
          </a>

          <a href={`${base}contatti/`}>
            Contatti
          </a>
        </div>

        <a
          href={`${base}contatti/`}
          class="header-cta"
        >
          Inizia ora
        </a>

      </div>
    </header>


    <main class="courses-page">

      <section class="courses-hero">
        <div class="container">

          <p class="courses-label">
            DFL GYM · TIVOLI TERME
          </p>

          <h1>
            TROVA IL TUO<br />
            <span>MODO DI ALLENARTI.</span>
          </h1>

          <p class="courses-intro">
            Percorsi diversi, un unico obiettivo:
            aiutarti a migliorare, giorno dopo giorno.
          </p>

        </div>
      </section>


      <section class="courses-list">

        <div class="container">

          <div class="courses-section-heading">
            <p class="courses-label">
              I NOSTRI PERCORSI
            </p>

            <h2>
              SCEGLI COME<br />
              <span>ALLENARTI.</span>
            </h2>
          </div>


          <div class="courses-grid">

            <article class="course-card">

              <div class="course-card-image">
                <img
                  src={`${base}images/corsi-sala-pesi.jpg`}
                  alt="Sala pesi DFL GYM"
                />
              </div>

              <div class="course-card-content">

                <span class="course-number">
                  01
                </span>

                <h3>
                  SALA PESI
                </h3>

                <p>
                  Uno spazio completo per allenarti in autonomia,
                  migliorare forza e forma fisica e costruire il
                  tuo percorso con costanza.
                </p>

                <a
                  href={`${base}contatti/`}
                  class="secondary-button"
                >
                  Scopri di più
                </a>

              </div>

            </article>


            <article class="course-card">

              <div class="course-card-image">
                <img
                  src={`${base}images/corsi-karate.jpg`}
                  alt="Corso di Karate DFL GYM"
                />
              </div>

              <div class="course-card-content">

                <span class="course-number">
                  02
                </span>

                <h3>
                  KARATE
                </h3>

                <p>
                  Tecnica, disciplina e controllo. Un percorso
                  dedicato a chi vuole sviluppare corpo e mente
                  attraverso le arti marziali.
                </p>

                <a
                  href={`${base}contatti/`}
                  class="secondary-button"
                >
                  Scopri di più
                </a>

              </div>

            </article>


            <article class="course-card">

              <div class="course-card-image">
                <img
                  src={`${base}images/corsi-personal.png`}
                  alt="Personal Training DFL GYM"
                />
              </div>

              <div class="course-card-content">

                <span class="course-number">
                  03
                </span>

                <h3>
                  PERSONAL TRAINING
                </h3>

                <p>
                  Un percorso costruito sulle tue esigenze,
                  con attenzione, metodo e un programma pensato
                  per raggiungere i tuoi obiettivi.
                </p>

                <a
                  href={`${base}contatti/`}
                  class="secondary-button"
                >
                  Scopri di più
                </a>

              </div>

            </article>

          </div>

        </div>

      </section>


      <section class="courses-cta">

        <div class="container">

          <p class="courses-label">
            NON SAI DA DOVE INIZIARE?
          </p>

          <h2>
            PARLIAMONE.<br />
            <span>TROVIAMO IL TUO PERCORSO.</span>
          </h2>

          <a
            href={`${base}contatti/`}
            class="primary-button"
          >
            Inizia ora
          </a>

        </div>

      </section>

    </main>


    <script>
      import '../scripts/mobile-menu.js';
    </script>

  </body>
</html>