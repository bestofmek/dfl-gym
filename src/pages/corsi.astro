---
import '../styles/global.css';
import '../styles/corsi.css';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="DFL GYM - Scopri i nostri corsi e trova il percorso di allenamento più adatto a te."
    />
    <title>Corsi | DFL GYM</title>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">

        <a href="/" class="logo" aria-label="DFL GYM Home">
          <img
            src="/images/dfl-gym-logo.png"
            alt="DFL GYM"
            class="logo-image"
          />

          <span class="logo-text">
            <strong>DFL GYM</strong>
            <small>TIVOLI TERME</small>
          </span>
        </a>

        <nav class="main-nav" aria-label="Navigazione principale">
          <a href="/">La palestra</a>
          <a href="/corsi">Corsi</a>
          <a href="/orari">Orari</a>
          <a href="/contatti">Contatti</a>
        </nav>

        <a href="/contatti" class="header-cta">
          Inizia ora
        </a>

      </div>
    </header>

    <main class="courses-page">

      <section class="courses-hero">
        <div class="container">

          <h1>
            SCOPRI IL TUO<br />
            <span>ALLENAMENTO.</span>
          </h1>

          <p class="courses-intro">
            Percorsi pensati per obiettivi diversi, un unico ambiente
            dedicato alla tua crescita.
          </p>

        </div>
      </section>


      <section class="courses-list">
        <div class="container">

          <article class="course-card">
            <div class="course-number">01</div>

            <div class="course-content">
              <p class="course-label">ALLENAMENTO</p>

              <h2>SALA PESI</h2>

              <p>
                Tutto lo spazio e l'attrezzatura di cui hai bisogno
                per costruire il tuo allenamento, migliorare la tua
                forza e raggiungere i tuoi obiettivi.
              </p>

              <a href="/contatti" class="course-link">
                Scopri di più →
              </a>
            </div>

            <div class="course-placeholder">
             <img src="/images/corsi-sala-pesi.jpg"
                  alt="Sala pesi DFL GYM"/>
            </div>
          </article>


          <article class="course-card">
            <div class="course-number">02</div>

            <div class="course-content">
              <p class="course-label">CORSO</p>

              <h2>KARATE</h2>

              <p>
                Perfetta combinazione di disciplina, forza e agilità, il corso di Karate ti aiuta a sviluppare il corpo e la mente.
                Per adulti e bambini.
              </p>

              <a href="/contatti" class="course-link">
                Scopri di più →
              </a>
            </div>

            <div class="course-placeholder">
             <img src="/images/corsi-karate.jpg"
                  alt="Karate DFL GYM"/>
            </div>
          </article>


          <article class="course-card">
            <div class="course-number">03</div>

            <div class="course-content">
              <p class="course-label">PERCORSO PERSONALIZZATO</p>

              <h2>PERSONAL<br />TRAINING</h2>

              <p>
                Un percorso costruito sulle tue esigenze, con
                attenzione, metodo e un programma pensato per
                accompagnarti verso i tuoi obiettivi.
              </p>

              <a href="/contatti" class="course-link">
                Scopri di più →
              </a>
            </div>

          <div class="course-placeholder">
             <img src="/images/corsi-personal.png"
                  alt="Personal Training DFL GYM"/>
            </div>
          </article>

        </div>
      </section>


      <section class="courses-cta">
        <div class="container">

          <p>PRONTO A INIZIARE?</p>

          <h2>
            IL TUO PERCORSO<br />
            <span>COMINCIA QUI.</span>
          </h2>

          <a href="/contatti" class="primary-button">
            Inizia il tuo percorso
          </a>

        </div>
      </section>

    </main>

  </body>
</html>